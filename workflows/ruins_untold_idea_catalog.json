  "nodes": [
    {
      "parameters": {},
      "id": "d87e28a7-9a0c-448d-8d84-2355f56efb71",
      "name": "Run Idea Generation",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -416,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Resolve generation parameters \u2014 reads from webhook body if present, falls back to defaults.\n// Works for both webhook-triggered runs (body.quantity / body.keyword) and manual trigger runs.\nconst body = (items[0] && items[0].json && items[0].json.body) ? items[0].json.body : {};\n\nconst ideasCount = (body.quantity && parseInt(String(body.quantity), 10) > 0)\n  ? parseInt(String(body.quantity), 10)\n  : 10;\n\nconst topic = (body.keyword && String(body.keyword).trim())\n  ? String(body.keyword).trim()\n  : '';\n\nreturn [{ json: {\n  spreadsheetId: '1kF8cfyh3qZZIcPcSWYs8olZZYPxFhxBTUhtjK04Eb68',\n  sheetName:     'Ideas',\n  ideasCount,\n  topic,\n} }];"
      },
      "id": "2a35b6d3-4dd5-4696-8df9-d668be2ab6c9",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        144
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3333/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  prompt:\n    'You are the lead researcher and content strategist for Ruins Untold, a long-form YouTube channel covering ancient mysteries, forbidden archaeology, and alternative history. Generate exactly ' +\n    $('Config').first().json.ideasCount +\n    ' video ideas as a pure JSON array with no markdown fences, no preamble, and no explanation. Each idea must use this exact schema: {topic: short punchy title 5-10 words, angle: 3-5 sentences opening with mainstream consensus then cracking it with a physical anomaly naming the gatekeeper and ending on the unanswered question, key_evidence: minimum 4 specific items with paper titles dates artifacts locations documents years, key_researchers: named individuals with roles always including at least one antagonist labeled as such, related_video: prior Ruins Untold episode or none yet, hook_style: one of question statement contradiction anomaly revelation, tone_dial: integer 6-7 default never exceed 8}. Rules: every idea needs a concrete physical anomaly, a named gatekeeper institution, and specific dated sources. ' +\n    ($('Config').first().json.topic\n      ? 'All ' + $('Config').first().json.ideasCount + ' ideas must focus specifically on: ' + $('Config').first().json.topic + '.'\n      : 'Topics must span different eras, regions, and artifact types.') +\n    ' Output ONLY the raw JSON array starting with [ and ending with ]. No other text.'\n}) }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "b4654799-394d-49b3-89ac-2b86ad9a17f4",
      "name": "Generate Ideas via Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract text from claude-bridge.py response\nconst responseText = items[0].json.output.trim();\n\n// Parse the JSON array \u2014 handle edge case where model wraps in backticks\nlet ideas;\ntry {\n  ideas = JSON.parse(responseText);\n} catch (e) {\n  const stripped = responseText.replace(/^```json?\\n?|```$/gm, '').trim();\n  try {\n    ideas = JSON.parse(stripped);\n  } catch (e2) {\n    const match = stripped.match(/(\\[\\s*\\{[\\s\\S]*\\}\\s*\\])/);\n    if (!match) throw new Error('Could not parse ideas. Raw: ' + responseText.slice(0, 300));\n    ideas = JSON.parse(match[1]);\n  }\n}\n\nif (!Array.isArray(ideas)) throw new Error('Expected JSON array, got: ' + typeof ideas);\n\n// Normalize a field value \u2014 handles string, array of strings, array of objects, or null\nfunction str(val) {\n  if (val === null || val === undefined) return '';\n  if (Array.isArray(val)) {\n    return val.map(item => {\n      if (item === null || item === undefined) return '';\n      if (typeof item === 'object') {\n        // Flatten object: join all values with \" \u2014 \"\n        return Object.values(item).filter(v => v !== null && v !== undefined).join(' \u2014 ');\n      }\n      return String(item);\n    }).filter(s => s.length > 0).join('; ');\n  }\n  if (typeof val === 'object') return Object.values(val).filter(v => v !== null && v !== undefined).join(' \u2014 ');\n  return String(val).trim();\n}\n\n// Tag each item as a new idea so Filter Duplicates can identify it\nreturn ideas.map(idea => ({\n  json: {\n    __type:          'new_idea',\n    topic:           str(idea.topic),\n    angle:           str(idea.angle),\n    key_evidence:    str(idea.key_evidence),\n    key_researchers: str(idea.key_researchers),\n    hook_style:      str(idea.hook_style),\n    tone_dial:       str(idea.tone_dial || 7),\n    related_video:   str(idea.related_video) || 'none yet'\n  }\n}));"
      },
      "id": "1c94296c-df78-48fa-98bf-9dec541263d8",
      "name": "Parse Ideas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('Config').first().json.sheetName }}",
          "mode": "name"
        },
        "options": {}
      },
      "id": "472137c4-7118-4eff-9c82-341b790d6105",
      "name": "Read Existing Topics",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        0,
        288
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "5KlwkkXYEjhrIznj",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {},
      "id": "bf6a6e44-a0aa-4f82-8099-3f6490abca7c",
      "name": "Merge Ideas and Sheet",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        448,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Items are a mix of new ideas (tagged __type: 'new_idea') and existing sheet rows\nconst newIdeas     = items.filter(i => i.json.__type === 'new_idea');\nconst existingRows = items.filter(i => i.json.__type !== 'new_idea');\n\n// Build a set of existing topics \u2014 normalised to lowercase, collapsed whitespace\nconst existingTopics = new Set(\n  existingRows\n    .map(row => (row.json.TOPIC || '').toLowerCase().replace(/\\s+/g, ' ').trim())\n    .filter(t => t.length > 0)\n);\n\nconst uniqueIdeas = newIdeas.filter(idea => {\n  const topic = (idea.json.topic || '').toLowerCase().replace(/\\s+/g, ' ').trim();\n  return !existingTopics.has(topic);\n});\n\nreturn uniqueIdeas.length > 0 ? uniqueIdeas : [{ json: { __noNewIdeas: true } }];"
      },
      "id": "7c357f5c-a0c8-4447-b8f2-c28ee6fef23c",
      "name": "Filter Duplicates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        144
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.__noNewIdeas }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
